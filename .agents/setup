#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

node_major="$(tr -d '[:space:]' < .node-version)"
npm_version="$(sed -n 's/.*"packageManager": "npm@\([^"]*\)".*/\1/p' package.json)"
local_bin="$HOME/.local/bin"
node_install_root="$HOME/.local/share/nodejs"

if [[ "$($local_bin/node --version 2>/dev/null || true)" != v"$node_major".* ]]; then
  echo "==> Installing Node.js ${node_major}.x"
  case "$(uname -m)" in
    x86_64) node_arch="x64" ;;
    aarch64|arm64) node_arch="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac

  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT
  curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/SHASUMS256.txt" -o "$temp_dir/SHASUMS256.txt"
  node_archive="$(sed -n "s/^[[:xdigit:]]\{64\}  \(node-v${node_major}\.[0-9.]*-linux-${node_arch}\.tar\.xz\)$/\1/p" "$temp_dir/SHASUMS256.txt")"
  [[ -n "$node_archive" ]] || { echo "Unable to resolve Node.js ${node_major}.x for ${node_arch}" >&2; exit 1; }
  curl -fsSL "https://nodejs.org/dist/latest-v${node_major}.x/${node_archive}" -o "$temp_dir/$node_archive"
  (cd "$temp_dir" && sha256sum --check --ignore-missing SHASUMS256.txt)
  mkdir -p "$node_install_root"
  tar -xJf "$temp_dir/$node_archive" -C "$temp_dir"
  node_dir="$node_install_root/${node_archive%-linux-${node_arch}.tar.xz}"
  [[ -d "$node_dir" ]] || mv "$temp_dir/${node_archive%.tar.xz}" "$node_dir"
else
  node_dir="$(cd "$(dirname "$(readlink -f "$local_bin/node")")/.." && pwd)"
fi

mkdir -p "$local_bin"
for executable in node npm npx corepack; do
  [[ -e "$node_dir/bin/$executable" ]] && ln -sfn "$node_dir/bin/$executable" "$local_bin/$executable"
done

profile_marker="# crit Node.js toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# crit Node.js toolchain
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF
fi

export PATH="$local_bin:$PATH"
hash -r
echo "==> Using $(node --version)"

if [[ "$(npm --version 2>/dev/null || true)" != "$npm_version" ]]; then
  echo "==> Installing npm ${npm_version}"
  npm install --global "npm@${npm_version}"
  hash -r
fi

echo "==> Installing lockfile dependencies with npm $(npm --version)"
npm ci

echo "==> Orb setup complete"
