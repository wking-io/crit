{
  "name": "@riff-refine/crit",
  "version": "0.1.0-alpha.0",
  "description": "A local-first canvas for arranging and assessing live web iterations.",
  "license": "MIT",
  "keywords": [
    "design-review",
    "infinite-canvas",
    "react",
    "vite",
    "effect"
  ],
  "homepage": "https://github.com/wking-io/crit#readme",
  "bugs": {
    "url": "https://github.com/wking-io/crit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wking-io/crit.git"
  },
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "skills",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./tokens.css": "./src/react/base-tokens.css"
  },
  "scripts": {
    "build": "npm run generate:glyphs && tsc -p tsconfig.build.json",
    "build:target": "tsc -b tsconfig.target.json",
    "check:glyphs": "node scripts/generate-glyphs.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "check:target-boundaries": "node scripts/check-target-boundaries.mjs",
    "dev": "npm run build --silent && node playground/seed.mjs && vite --config playground/vite.config.ts",
    "dev:agent": "npm run build --silent && cd playground && CRIT_FEATURE_PROFILE=development node ../dist/cli.js",
    "dev:phone": "PORTLESS_LAN=1 PORTLESS_HTTPS=0 PORTLESS_PORT=80 portless",
    "dev:portless": "PORTLESS_PORT=443 portless",
    "dev:seed": "npm run build --silent && node playground/seed.mjs",
    "playground:alpha": "CRIT_PLAYGROUND_MODE=alpha npm run dev",
    "playground:alpha:agent": "npm run build --silent && cd playground && CRIT_FEATURE_PROFILE=alpha node ../dist/cli.js",
    "playground:release": "CRIT_PLAYGROUND_MODE=release npm run dev",
    "postbuild": "node scripts/mark-executable.mjs",
    "prepublishOnly": "npm run verify",
    "generate:glyphs": "node scripts/generate-glyphs.mjs",
    "hosted:deploy": "npm run hosted:stage && npx wrangler deploy --config packages/cloudflare/wrangler.jsonc --env production",
    "hosted:stage": "node scripts/stage-hosted-assets.mjs",
    "import:glyph": "node scripts/import-nucleo-glyph.mjs",
    "lint": "oxlint",
    "doctor": "npm --workspace @crit/react run doctor",
    "test": "vitest run",
    "typecheck": "npm run check:glyphs && tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:package && npm run doctor",
    "www:build": "vite build --config www/vite.config.ts",
    "www:deploy": "npm run www:build && npx wrangler pages deploy www/dist --project-name crit",
    "www:dev": "vite --config www/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@effect/platform-node": "4.0.0-rc.109",
    "@tanstack/react-hotkeys": "^0.10.0",
    "dialkit": "^1.4.3",
    "effect": "4.0.0-rc.109",
    "esbuild": "0.28.1",
    "motion": "^13.0.0",
    "node-html-parser": "6.1.13"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.109",
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.5",
    "oxlint": "^1.78.0",
    "portless": "0.15.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "portless": {
    "name": "crit",
    "script": "dev"
  },
  "packageManager": "npm@11.11.0"
}
