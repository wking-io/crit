{
  "name": "@riff-refine/crit",
  "version": "0.0.0",
  "description": "A local-first canvas for arranging and assessing live web iterations.",
  "keywords": [
    "design-review",
    "infinite-canvas",
    "react",
    "vite",
    "effect"
  ],
  "homepage": "https://github.com/wking-io/crit#readme",
  "bugs": {
    "url": "https://github.com/wking-io/crit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wking-io/crit.git"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "crit": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:package": "node scripts/check-package.mjs",
    "dev": "npm run build --silent && node playground/seed.mjs && vite --config playground/vite.config.ts",
    "dev:agent": "npm run build --silent && cd playground && node ../dist/cli.js",
    "dev:portless": "PORTLESS_PORT=443 portless",
    "dev:seed": "npm run build --silent && node playground/seed.mjs",
    "postbuild": "node scripts/mark-executable.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run check:package"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.105",
    "@tanstack/react-hotkeys": "^0.10.0",
    "dialkit": "^1.4.3",
    "effect": "4.0.0-beta.105",
    "esbuild": "0.28.1",
    "motion": "^13.0.0",
    "node-html-parser": "6.1.13"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.105",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.5",
    "portless": "0.15.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "portless": {
    "name": "crit",
    "script": "dev"
  },
  "packageManager": "npm@11.11.0"
}
