{
  "name": "@riff-refine/crit",
  "version": "0.0.0",
  "description": "A local-first canvas for arranging and assessing live web iterations.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "README.md",
    "ARCHITECTURE.md"
