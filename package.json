{
  "name": "@riff-refine/crit",
  "version": "0.0.0",
  "description": "A local-first canvas for arranging and assessing live web iterations.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "crit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/mark-executable.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.105",
    "@tldraw/store": "4.2.1",
    "@tldraw/tlschema": "4.2.1",
    "@tldraw/utils": "4.2.1",
    "@tldraw/validate": "4.2.1",
    "effect": "4.0.0-beta.105",
    "tldraw": "4.2.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.105",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "fake-indexeddb": "6.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "npm@11.11.0"
}
