{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/domain/*": ["../domain/src/*"],
      "@crit/protocol": ["../protocol/src/index.ts"],
      "@crit/protocol/*": ["../protocol/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../domain" },
    { "path": "../protocol" }
  ]
}
