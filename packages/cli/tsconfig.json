{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/local": ["../local/src/index.ts"],
      "@crit/replica": ["../replica/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../domain" },
    { "path": "../replica" },
    { "path": "../local" }
  ]
}
