{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/representations": ["../representations/src/index.ts"]
