{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/frame-bridge": ["../frame-bridge/src/index.ts"],
      "@crit/protocol": ["../protocol/src/index.ts"],
      "@crit/replica": ["../replica/src/index.ts"],
      "@crit/representations": ["../representations/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../domain" },
    { "path": "../frame-bridge" },
    { "path": "../protocol" },
    { "path": "../replica" },
    { "path": "../representations" }
  ]
}
