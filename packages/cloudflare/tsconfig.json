{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@crit/authority": ["../authority/src/index.ts"],
      "@crit/authority/adapter": ["../authority/src/adapter.ts"],
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/protocol": ["../protocol/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../authority" },
    { "path": "../domain" },
    { "path": "../protocol" }
  ]
}
