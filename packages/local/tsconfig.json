{
  "extends": "../../tsconfig.target.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@crit/authority": ["../authority/src/index.ts"],
      "@crit/authority/adapter": ["../authority/src/adapter.ts"],
      "@crit/client": ["../client/src/index.ts"],
      "@crit/domain": ["../domain/src/index.ts"],
      "@crit/protocol": ["../protocol/src/index.ts"],
      "@crit/replica": ["../replica/src/index.ts"],
      "@crit/replica/adapter": ["../replica/src/adapter.ts"],
      "@crit/replica/http": ["../replica/src/http.ts"],
      "@crit/replica/testing": ["../replica/src/testing.ts"],
      "@crit/representations": ["../representations/src/index.ts"],
      "@crit/representations/adapter": ["../representations/src/adapter.ts"],
      "@crit/representations/testing": ["../representations/src/testing.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../authority" },
    { "path": "../client" },
    { "path": "../domain" },
    { "path": "../protocol" },
    { "path": "../replica" },
    { "path": "../representations" }
  ]
}
