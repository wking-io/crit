{
  "name": "@crit/frame-bridge",
  "version": "0.0.0",
  "description": "Framework-neutral Frame Bridge for live Frames.",
  "license": "MIT",
  "homepage": "https://github.com/wking-io/crit#readme",
  "bugs": {
    "url": "https://github.com/wking-io/crit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wking-io/crit.git",
    "directory": "packages/frame-bridge"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepack": "tsc -b",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@crit/protocol": "0.0.0",
    "effect": "4.0.0-rc.109"
  },
  "peerDependencies": {
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
